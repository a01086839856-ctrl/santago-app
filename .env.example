# 이 파일을 복사해 .env.local을 만들고 값을 채운다:  cp .env.example .env.local
# .env.local은 깃에 올라가지 않는다. 키 값은 카톡 등으로 따로 주고받는다.
# NEXT_PUBLIC_으로 시작하는 값은 브라우저 코드에 그대로 들어가므로 비밀 키를 넣지 않는다.

# DB 연결 주소 (DAR-001, 윤태현). AWS RDS PostgreSQL. 끝의 ?sslmode=require는 꼭 붙인다(RDS는 암호화 접속만 받음)
# 형식: postgresql://사용자이름:비밀번호@RDS엔드포인트:5432/santago?sslmode=require
DATABASE_URL=""

# 카카오맵 JavaScript 키 (SFR-008·009, 강도현)
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=

# 길찾기 API용 REST 키, 서버에서만 사용 (SFR-009, 강도현)
KAKAO_REST_API_KEY=

# 구글 애널리틱스 측정 ID, G-로 시작 (SFR-010, 강도현)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# 토스페이먼츠 테스트 키 (SFR-004, 강도현). 클라이언트 키는 브라우저용, 시크릿 키는 서버 전용
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 소셜 로그인 (SFR-007, 윤태현). 모두 서버 전용이라 NEXT_PUBLIC_을 붙이지 않는다
# 로그인 쿠키 서명용 비밀값(32자 이상). 아래 명령으로 만든다:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# 우리 서비스 주소. 개발은 비워 둬도 된다(지금 연 주소를 씀). 배포 서버는 https://도메인 으로 꼭 채운다
APP_URL=
# 카카오 로그인: [앱] > [플랫폼 키] > [REST API 키]의 키와 클라이언트 시크릿
# 리다이렉트 URI 등록값: http://localhost:3000/api/auth/kakao/callback
KAKAO_LOGIN_REST_API_KEY=
KAKAO_LOGIN_CLIENT_SECRET=
# 구글 로그인: Google Auth Platform > Clients의 웹 애플리케이션 클라이언트 ID와 보안 비밀번호
# 승인된 리디렉션 URI 등록값: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
