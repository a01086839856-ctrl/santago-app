# 이 파일을 복사해 .env.local을 만들고 값을 채운다:  cp .env.example .env.local
# .env.local은 깃에 올라가지 않는다. 키 값은 카톡 등으로 따로 주고받는다.
# NEXT_PUBLIC_으로 시작하는 값은 브라우저 코드에 그대로 들어가므로 비밀 키를 넣지 않는다.

# DB 연결 주소 (DAR-001, 윤태현)
DATABASE_URL=

# 카카오맵 JavaScript 키 (SFR-008·009, 강도현)
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=

# 길찾기 API용 REST 키, 서버에서만 사용 (SFR-009, 강도현)
KAKAO_REST_API_KEY=

# 구글 애널리틱스 측정 ID, G-로 시작 (SFR-010, 강도현)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# 토스페이먼츠 테스트 키 (SFR-004, 강도현). 클라이언트 키는 브라우저용, 시크릿 키는 서버 전용
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 소셜 로그인 키 (SFR-007, 윤태현): 방식이 정해지면 여기에 추가
